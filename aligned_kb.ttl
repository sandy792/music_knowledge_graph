@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix ex: <http://musickg.example.org/resource/> .
@prefix exo: <http://musickg.example.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

exo:activeFrom a owl:DatatypeProperty ;
    rdfs:label "activeFrom"@en ;
    exo:alignmentConfidence 0.85 ;
    rdfs:comment "P571 pour groupes, P569 pour individus"@fr ;
    owl:equivalentProperty wdt:P571 .

exo:activeTo a owl:DatatypeProperty ;
    rdfs:label "activeTo"@en ;
    exo:alignmentConfidence 0.85 ;
    rdfs:comment "P576 pour groupes, P570 pour individus"@fr ;
    owl:equivalentProperty wdt:P576 .

exo:collaboratedWith a owl:ObjectProperty ;
    rdfs:label "collaboratedWith"@en ;
    exo:alignmentConfidence 0.7 ;
    rdfs:comment "P1327 trop generique, le notre est musical"@fr ;
    rdfs:domain exo:Artist ;
    rdfs:range exo:Artist ;
    rdfs:subPropertyOf wdt:P1327 .

exo:hasGenre a owl:ObjectProperty ;
    rdfs:label "hasGenre"@en ;
    exo:alignmentConfidence 0.99 ;
    rdfs:comment "match exact"@fr ;
    rdfs:domain exo:Artist ;
    rdfs:range exo:MusicGenre ;
    owl:equivalentProperty dbo:genre,
        wdt:P136 .

exo:hasMember a owl:ObjectProperty ;
    rdfs:label "hasMember"@en ;
    exo:alignmentConfidence 0.88 ;
    rdfs:comment "hasMember est plus specifique que hasPart"@fr ;
    rdfs:domain exo:MusicGroup ;
    rdfs:range exo:SoloArtist ;
    rdfs:subPropertyOf wdt:P527 ;
    owl:equivalentProperty dbo:bandMember .

exo:influencedBy a owl:ObjectProperty ;
    rdfs:label "influencedBy"@en ;
    exo:alignmentConfidence 0.99 ;
    rdfs:comment "match exact"@fr ;
    rdfs:domain exo:Artist ;
    rdfs:range exo:Artist ;
    owl:equivalentProperty dbo:influencedBy,
        wdt:P737 .

exo:memberOf a owl:ObjectProperty ;
    rdfs:label "memberOf"@en ;
    exo:alignmentConfidence 0.97 ;
    rdfs:comment "match exact"@fr ;
    rdfs:domain exo:SoloArtist ;
    rdfs:range exo:MusicGroup ;
    owl:equivalentProperty dbo:bandMember,
        wdt:P463 .

exo:originCountry a owl:ObjectProperty ;
    rdfs:label "originCountry"@en ;
    exo:alignmentConfidence 0.9 ;
    rdfs:comment "P495 pour groupes, P27 pour individus"@fr ;
    rdfs:domain exo:Artist ;
    rdfs:range exo:Country ;
    owl:equivalentProperty dbo:birthPlace,
        wdt:P495 .

exo:releaseYear a owl:DatatypeProperty ;
    rdfs:label "releaseYear"@en ;
    exo:alignmentConfidence 0.96 ;
    rdfs:comment "match exact"@fr ;
    owl:equivalentProperty wdt:P577 .

exo:releasedAlbum a owl:ObjectProperty ;
    rdfs:label "releasedAlbum"@en ;
    exo:alignmentConfidence 0.85 ;
    rdfs:comment "P358 plus large mais le plus proche"@fr ;
    rdfs:domain exo:Artist ;
    rdfs:range exo:Album ;
    owl:equivalentProperty dbo:album,
        wdt:P358 .

exo:signedTo a owl:ObjectProperty ;
    rdfs:label "signedTo"@en ;
    exo:alignmentConfidence 0.98 ;
    rdfs:comment "match exact"@fr ;
    rdfs:domain exo:Artist ;
    rdfs:range exo:RecordLabel ;
    owl:equivalentProperty dbo:recordLabel,
        wdt:P264 .

exo:wikidataID a owl:DatatypeProperty ;
    rdfs:label "wikidataID"@en .

ex:Adele a exo:SoloArtist,
        foaf:Person ;
    rdfs:label "Adele"@en ;
    exo:activeFrom "2006"^^xsd:gYear ;
    exo:alignmentConfidence 0.97 ;
    exo:alignmentStrategy "context" ;
    exo:hasGenre ex:Genre_R%26B,
        ex:Genre_pop,
        ex:Genre_soul ;
    exo:originCountry ex:Country_GB ;
    exo:releasedAlbum ex:Album_19,
        ex:Album_21,
        ex:Album_30 ;
    exo:signedTo ex:Label_XL_Recordings ;
    exo:wikidataID "Q81771" ;
    owl:sameAs wd:Q81771 ;
    foaf:name "Adele" .

